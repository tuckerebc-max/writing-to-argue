{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anri.local/schemas/learner-decision.schema.json",
  "title": "ANRI learner decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "checkpoint", "options_considered", "selected_option", "reason"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string", "minLength": 1},
    "options_considered": {"type": "array", "items": {"type": "string"}},
    "selected_option": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "artifact_effect": {"type": "string"}
  }
}
